# SPDX-License-Identifier: Apache-2.0
# Read stored term frequencies, positions and offsets
# Inspired by: https://svn.apache.org/repos/asf/lucene/pylucene/trunk/samples/TermPositionVector.py
# Expected: red frequency 2 at positions 0 and 2; blue frequency 1
# Run from repository root: lmscript lmcode/examples/gallery/16_term_vectors.lms
mkdir("lmcode/build/gallery");
program = _lmcode_ schema="../../lucene.dsl.json";
let directory = memory_directory();
let analyzer = standard_analyzer();
let writer = index_writer(directory, writer_config(analyzer));

writer.add(document().vector_text("body", "red blue red", true));
let reader = writer.reader();
let terms = reader.term_vectors(0, "body");
assert_true(terms.len() == 2, "two unique terms");
let seen = 0;
for (term in terms) {
  if (term.term() == "red") {
    assert_true(term.len() == 2, "red frequency");
    assert_true(term.at(0).position() == 0 && term.at(1).position() == 2, "red positions");
    assert_true(term.at(1).start() == 9 && term.at(1).end() == 12, "second red offsets");
    seen = seen + 1;
  }
  term.tokens().emit(term.term());
}
assert_true(seen == 1, "red found");
assert_true(reader.term_vectors(0, "missing").len() == 0, "missing vector field");
end _lmcode_
savedsl(program, "lmcode/build/gallery/16_term_vectors.dslb");
r = system lmcode/lmlucene --dsl lmcode/build/gallery/16_term_vectors.dslb;
if (r.code != 0) { print(r.stderr); }
assert(r.code == 0);
print(r.stdout);
