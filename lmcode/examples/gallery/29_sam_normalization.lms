# SPDX-License-Identifier: Apache-2.0
# Override analysis with a domain vocabulary rule
# Inspired by: https://svn.apache.org/repos/asf/lucene/pylucene/trunk/samples/PorterStemmerAnalyzer.py
# Expected: both spellings match; emitted tokens are car and color
# Run from repository root: lmscript lmcode/examples/gallery/29_sam_normalization.lms
# Adaptation: Uses lmcode SAM entry dispatch from a Java TokenFilter instead of PyLucene’s PythonAnalyzer subclass.
mkdir("lmcode/build/gallery");
program = _lmcode_ schema="../../lucene.dsl.json";
@analysis
fn vocabulary(token: string) -> string implements TokenTransform {
  let normalized = token;
  if (token == "automobile") { normalized = "car"; }
  if (token == "colour") { normalized = "color"; }
  return normalized;
}
let directory = memory_directory();
let analyzer = rule_analyzer("vocabulary");
let writer = index_writer(directory, writer_config(analyzer));
writer.add(document().keyword("id", "1", true).text("body", "automobile colour", true));
let reader = writer.reader();
let searcher = index_searcher(reader);
let hits = searcher.search(parse_query("body", "car AND color", analyzer), 10);
assert_true(hits.total() == 1, "canonical vocabulary matches");
assert_true(searcher.count(parse_query("body", "automobile AND colour", analyzer)) == 1, "query-time rule also runs");
analyzer.tokens("body", "automobile colour").emit("normalized tokens");
hits.emit("canonical query");
end _lmcode_
savedsl(program, "lmcode/build/gallery/29_sam_normalization.dslb");
r = system lmcode/lmlucene --dsl lmcode/build/gallery/29_sam_normalization.dslb;
if (r.code != 0) { print(r.stderr); }
assert(r.code == 0);
print(r.stdout);
