# SPDX-License-Identifier: Apache-2.0
# English stemming and stop words
# Inspired by: https://svn.apache.org/repos/asf/lucene/pylucene/trunk/samples/PorterStemmerAnalyzer.py
# Expected: run matches both documents and the is removed
# Run from repository root: lmscript lmcode/examples/gallery/13_english_stemming.lms
# Adaptation: Uses built-in EnglishAnalyzer; its pipeline is not an exact copy of the historical custom Porter filter ordering.
mkdir("lmcode/build/gallery");
program = _lmcode_ schema="../../lucene.dsl.json";
let directory = memory_directory();
let analyzer = english_analyzer();
let writer = index_writer(directory, writer_config(analyzer));
writer.add(document().keyword("id", "running", true).text("body", "The runners are running", true));
writer.add(document().keyword("id", "run", true).text("body", "They run daily", true));
let reader = writer.reader();
let searcher = index_searcher(reader);
let hits = searcher.search(parse_query("body", "run", analyzer), 10);
assert_true(hits.total() == 2, "running and run share a stem");
assert_true(searcher.count(term_query("body", "the")) == 0, "stop word removed");
analyzer.tokens("body", "The runners are running").emit("English tokens");
hits.emit("stemmed search");
end _lmcode_
savedsl(program, "lmcode/build/gallery/13_english_stemming.dslb");
r = system lmcode/lmlucene --dsl lmcode/build/gallery/13_english_stemming.dslb;
if (r.code != 0) { print(r.stderr); }
assert(r.code == 0);
print(r.stdout);
