# SPDX-License-Identifier: Apache-2.0
# Near-real-time readers are immutable snapshots
# Inspired by: https://lucene.apache.org/core/10_5_0/core/org/apache/lucene/search/IndexSearcher.html
# Expected: old reader sees 1; new reader sees 2 without commit
# Run from repository root: lmscript lmcode/examples/gallery/19_reader_snapshots.lms
mkdir("lmcode/build/gallery");
program = _lmcode_ schema="../../lucene.dsl.json";
let directory = memory_directory();
let analyzer = standard_analyzer();
let writer = index_writer(directory, writer_config(analyzer));

writer.add(document().keyword("id", "1", true));
let before = writer.reader();
writer.add(document().keyword("id", "2", true));
let after = writer.reader();
assert_true(before.num_docs() == 1, "old reader unchanged");
assert_true(after.num_docs() == 2, "new reader sees additions without commit");
index_searcher(before).search(all_query(), 10).emit("old snapshot");
index_searcher(after).search(all_query(), 10).emit("new snapshot");
end _lmcode_
savedsl(program, "lmcode/build/gallery/19_reader_snapshots.dslb");
r = system lmcode/lmlucene --dsl lmcode/build/gallery/19_reader_snapshots.dslb;
if (r.code != 0) { print(r.stderr); }
assert(r.code == 0);
print(r.stdout);
