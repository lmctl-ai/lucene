# SPDX-License-Identifier: Apache-2.0
# Boost one term to change ranking
# Inspired by: https://lucene.apache.org/core/10_5_0/queryparser/org/apache/lucene/queryparser/classic/package-summary.html
# Expected: matching ids 1, 2
# Run from repository root: lmscript lmcode/examples/gallery/12_boosted_query.lms
mkdir("lmcode/build/gallery");
program = _lmcode_ schema="../../lucene.dsl.json";
let directory = memory_directory();
let analyzer = standard_analyzer();
let writer = index_writer(directory, writer_config(analyzer));
writer.add(document().keyword("id", "1", true).text("body", "lucene", true));
writer.add(document().keyword("id", "2", true).text("body", "python", true));
let reader = writer.reader();
let searcher = index_searcher(reader);
let hits = searcher.search(parse_query("body", "lucene^4 OR python", analyzer), 10);
assert_true(hits.total() == 2, "expected match count");
let found = str_map();
for (hit in hits) { found.set(hit.document().get("id"), "yes"); }
assert_true(found.has("1"), "expected document 1");
assert_true(found.has("2"), "expected document 2");
assert_true(hits.at(0).document().get("id") == "1", "boosted term ranks first");
assert_true(hits.at(0).score() > hits.at(1).score(), "score changes");
hits.emit("Boost one term to change ranking");
end _lmcode_
savedsl(program, "lmcode/build/gallery/12_boosted_query.dslb");
r = system lmcode/lmlucene --dsl lmcode/build/gallery/12_boosted_query.dslb;
if (r.code != 0) { print(r.stderr); }
assert(r.code == 0);
print(r.stdout);
