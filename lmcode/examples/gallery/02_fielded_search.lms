# SPDX-License-Identifier: Apache-2.0
# Search titles and contents separately
# Inspired by: https://svn.apache.org/repos/asf/lucene/pylucene/trunk/samples/SearchFiles.py
# Expected: only id 1
# Run from repository root: lmscript lmcode/examples/gallery/02_fielded_search.lms
mkdir("lmcode/build/gallery");
program = _lmcode_ schema="../../lucene.dsl.json";
let directory = memory_directory();
let analyzer = standard_analyzer();
let writer = index_writer(directory, writer_config(analyzer));

writer.add(document().keyword("id", "1", true).text("title", "Lucene guide", true).text("body", "Java examples", true));
writer.add(document().keyword("id", "2", true).text("title", "Java guide", true).text("body", "Lucene examples", true));
let reader = writer.reader();
let searcher = index_searcher(reader);

let hits = searcher.search(parse_query("body", "title:lucene AND body:java", analyzer), 10);
assert_true(hits.total() == 1, "field-qualified conjunction");
assert_true(hits.at(0).document().get("id") == "1", "title match");
hits.emit("fielded query");
end _lmcode_
savedsl(program, "lmcode/build/gallery/02_fielded_search.dslb");
r = system lmcode/lmlucene --dsl lmcode/build/gallery/02_fielded_search.dslb;
if (r.code != 0) { print(r.stderr); }
assert(r.code == 0);
print(r.stdout);
